.env
.env.*
!.env.example
node_modules/
out/
.next/

# large binary reference material - keep locally, do not commit
reference/*.mp4
reference/frames/
.superpowers/

# Kept out of the public repo: the app teardown, the design-system
# screenshots and the internal specs. They live in ../mbb-private-docs.
reference/
docs/

# Local Worker secrets - never committed
cf/.dev.vars
cf/.wrangler/
cf/node_modules/

# Throwaway edit helpers
*.cjs

# FloBiz's own design assets: the festive theme illustrations and the download
# CTA. They are supplied separately and live only on the machine that renders,
# because THIS REPO IS PUBLIC - committing them would publish company artwork.
# The README in each folder says what the files are called. Without them the
# studio still runs: a theme with no art draws as a tinted card, and the clip
# closes on the plain logo instead of the CTA.
kit/themes/*.png
kit/cta/*.png
